# =============================================================================
# Dental Revenue OS — Environment Variables
# =============================================================================
# Copy this to .env.local and fill in actual values.
# Required variables are marked [REQUIRED]; optional ones are marked [OPTIONAL].

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Dental Revenue OS"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database [REQUIRED] ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dental_dev

# --- Authentication [REQUIRED] ---
AUTH_SECRET=your-auth-secret-at-least-32-characters-long
AUTH_URL=http://localhost:3000

# --- Object Storage [OPTIONAL - Phase 7+] ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# --- Email [OPTIONAL - Phase 6+] ---
# EMAIL_PROVIDER=
# EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# --- SMS [OPTIONAL - Phase 6+] ---
# SMS_PROVIDER=
# SMS_API_KEY=

# --- Redis [OPTIONAL] ---
# REDIS_URL=

# --- Monitoring [OPTIONAL] ---
# SENTRY_DSN=

# --- Supabase (Production) [OPTIONAL] ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
