# ==============================================================================
# DENTAL OS — PRODUCTION ENVIRONMENT VARIABLES (VERCEL & SUPABASE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Dental OS"
# Production domain (e.g. https://dental-os.vercel.app or custom clinic domain)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL CONNECTIONS
# ------------------------------------------------------------------------------
# A) Transaction Pooler URL (Port 6543, Supavisor Mode) - REQUIRED for Vercel Serverless
# Multiplexes serverless lambda traffic over persistent pool without exhausting connections.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# B) Direct Connection URL (Port 5432, Session Mode) - REQUIRED for Migrations
# Used by `npm run db:migrate` and `drizzle-kit` for schema changes and locks.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Optional: Supabase Client SDK (if utilizing storage buckets / realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 3. DATABASE PERFORMANCE & SERVERLESS SCALING TUNABLES
# ------------------------------------------------------------------------------
# Recommended max connections per serverless function (1 prevents connection spikes)
DB_MAX_CONNECTIONS=1
# Disables prepared statements for transaction pooler (handled automatically if port 6543 is detected)
DB_PREPARE="false"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION (NextAuth v5 / Auth.js)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 33
AUTH_SECRET="your-32-character-or-longer-random-secret"
AUTH_URL="https://your-app.vercel.app"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 5. INTEGRATIONS & CLINIC NOTIFICATIONS (OPTIONAL / PHASE-SPECIFIC)
# ------------------------------------------------------------------------------
# RESEND_API_KEY="re_..."
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+1..."

# ------------------------------------------------------------------------------
# 6. PREMIER PAYFAST PAYMENT GATEWAY (PAKISTAN / APPS)
# ------------------------------------------------------------------------------
# Official Merchant ID issued by Premier PayFast Pakistan
PAYFAST_MERCHANT_ID="YOUR_PAYFAST_MERCHANT_ID"

# Official Secured Key / Secret Key issued by Premier PayFast Pakistan
PAYFAST_SECURED_KEY="YOUR_PAYFAST_SECURED_KEY"

# Registered legal merchant name shown on hosted PayFast checkout
PAYFAST_MERCHANT_NAME="Dental OS"

# Optional Store ID (if multi-store is enabled in merchant portal)
PAYFAST_STORE_ID=""

# Environment mode: "production" or "sandbox"
PAYFAST_MODE="production"

# Official API endpoints
PAYFAST_PRODUCTION_BASE_URL="https://ipg1.apps.net.pk"
PAYFAST_SANDBOX_BASE_URL="https://ipguat.apps.net.pk"

# Centralized clinic registration fee in PKR (configurable for production verification)
REGISTRATION_FEE_PKR="50.00"
NEXT_PUBLIC_REGISTRATION_FEE_PKR="50.00"

# Hosted checkout return and callback URLs
# Hosted Return/IPN Endpoint: ${NEXT_PUBLIC_APP_URL}/api/payments/payfast/callback
# Status Screen: ${NEXT_PUBLIC_APP_URL}/register/payment/status

